DATABASE_URL=
# Manual Store Factory V2 schema apply accepts only a direct/unpooled endpoint.
DIRECT_URL=
# Optional direct/unpooled alternative accepted by the manual schema gate.
DATABASE_URL_UNPOOLED=
ADMIN_PASSWORD=
# Required in production; generate at least 32 random characters.
ADMIN_SESSION_SECRET=
# Optional separate signer for immutable generator plans. Production otherwise
# reuses ADMIN_SESSION_SECRET and still requires a strong configured secret.
GENERATOR_PLAN_SECRET=
# Required for live Stripe checkout; generate at least 32 random characters.
CHECKOUT_FINALIZATION_SECRET=
NEXT_PUBLIC_DEFAULT_STORE=drones
MOCK_CHECKOUT=true
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=

# Media storage
# Local dev can use MEDIA_STORAGE_PROVIDER=local with no Blob credentials.
# To test/use Vercel Blob locally, set MEDIA_STORAGE_PROVIDER=vercel-blob and
# provide either BLOB_READ_WRITE_TOKEN or VERCEL_OIDC_TOKEN from `vercel env pull`.
# New Vercel Blob stores connected to Vercel projects may use OIDC in production,
# so BLOB_READ_WRITE_TOKEN is optional when OIDC/default Vercel auth is available.
MEDIA_STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
VERCEL_OIDC_TOKEN=
# Usually provided by Vercel for connected Blob stores; set locally if OIDC auth asks for it.
BLOB_STORE_ID=

EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_EPN_CAMPAIGN_ID=
EBAY_BUY_ORDER_ENABLED=false

ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_DROPSHIP_ENABLED=false
ALIEXPRESS_API_ENDPOINT=
ALIEXPRESS_SEARCH_METHOD=

TEMU_APP_KEY=
TEMU_APP_SECRET=
TEMU_ACCESS_TOKEN=
TEMU_ENABLED=false

AMAZON_CREATOR_CREDENTIAL_ID=
AMAZON_CREATOR_CREDENTIAL_SECRET=
AMAZON_ASSOCIATE_TAG=
AMAZON_MARKETPLACE=US
AMAZON_SP_API_ENABLED=false

WISH_CLIENT_ID=
WISH_CLIENT_SECRET=
WISH_ACCESS_TOKEN=
WISH_ENABLED=false

ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_ACCESS_TOKEN=
ALIBABA_ENABLED=false

OPENAI_API_KEY=
AI_PROVIDER=mock

# Universal Store Factory V2 is preview-only and dark by default. Enabling
# these flags does not authorize LIVE routing, checkout, domains or indexing.
STOREFRONT_V2_ENABLED=false
STOREFRONT_V2_WISHLIST_ENABLED=false
# Comma-separated Store IDs explicitly authorized for persisted V2 admin
# actions. Empty means no store is a pilot, even when the global flag is true.
STOREFRONT_V2_PILOT_STORE_IDS=
# Only enable behind a separately trusted non-Vercel reverse proxy that strips
# client-supplied forwarding headers. Vercel provenance is handled separately.
STORE_FACTORY_V2_TRUST_PROXY_HEADERS=false
# Dedicated HMAC secret for tenant-bound anonymous wishlist identities.
# Required in production and must contain at least 32 random characters.
WISHLIST_SIGNING_SECRET=

AUTO_PUBLISH_MIN_SCORE=80
CATALOG_SYNC_BATCH_SIZE=20
# Catalog Autopilot runs supplier refresh daily and discovery weekly by default.
# Mock automation is always opt-in; synthetic fixtures must never enter an
# unattended production catalog by fallback.
CATALOG_REFRESH_CADENCE_HOURS=24
CATALOG_DISCOVERY_CADENCE_HOURS=168
CATALOG_REFRESH_LIMIT=6
CATALOG_ALLOW_MOCK_AUTOMATION=false
# LIVE checkout, supplier routing and Merchant feeds require both supplier sync
# and V3 product evaluation within this bounded window (allowed range: 1-168).
CATALOG_FRESHNESS_MAX_AGE_HOURS=48
MAX_MEDIA_FILE_MB=12
SUPPLIER_FETCH_TIMEOUT_MS=15000

# Payments (Stripe)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CAPTURE_MODE=manual

# Fulfillment
MANUAL_FULFILLMENT_ENABLED=false

# CJ Dropshipping
CJ_ENABLED=false
CJ_EMAIL=
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_PLATFORM_TOKEN=
CJ_ORDER_API_ENABLED=false
CJ_MANUAL_FULFILLMENT_ENABLED=false
# Live automatic routing is fail-closed unless this is the contract-verified synchronous value 2.
# Live checkout requires payType=2; payType=3 stays pending without a verified reconciliation loop.
CJ_ORDER_PAY_TYPE=2
CJ_LOGISTIC_NAME=
CJ_FROM_COUNTRY_CODE=CN

# Doba
DOBA_ENABLED=false
DOBA_ACCESS_KEY=
DOBA_APP_KEY=
DOBA_APP_SECRET=
